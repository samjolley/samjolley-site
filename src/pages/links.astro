---
import Base from '../layouts/Base.astro';
import { personalLinkGroups } from '../data/link-hub';
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Links | Sam Jolley',
  url: 'https://samjolley.com/links/',
  mainEntity: {
    '@type': 'Person',
    name: 'Sam Jolley',
    url: 'https://samjolley.com',
    image: 'https://samjolley.com/sam-jolley-headshot.webp',
    jobTitle: 'IT operations and automation engineer',
    worksFor: { '@type': 'Organization', name: 'ZeroBeatLabs', url: 'https://zerobeatlabs.org' },
    sameAs: ['https://github.com/samjolley', 'https://www.linkedin.com/in/samjolley'],
  },
};
const local=(href:string)=>href.startsWith('https://samjolley.com/')?new URL(href).pathname:href;
---
<Base structuredData={profileSchema} title="Links | Sam Jolley" description="Projects, writing, and places to find Sam Jolley.">
<article class="prose"><p class="eyebrow">Elsewhere</p><h1>Useful links.</h1>
{personalLinkGroups.map(group=><section class="link-group"><h2>{group.heading}</h2>{group.description&&<p>{group.description}</p>}<ul class="plain-links">{group.links.map(link=><li><a href={local(link.href)}>{link.label}</a>{link.description&&<p>{link.description}</p>}</li>)}</ul></section>)}
</article></Base>
