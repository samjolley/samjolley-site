---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('writing',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime()||a.id.localeCompare(b.id)).slice(0,2);
const work=await getCollection('work');
const selected=['antenna-tracker','homelab-self-hosting'].map(id=>work.find(w=>w.id===id)).filter(Boolean);
---
<Base title="Sam Jolley | Projects and field notes" description="IT systems, hardware projects, and notes on what I learn along the way.">
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">Projects &amp; field notes</p>
      <h1 id="intro-title">What I'm building (and figuring out!)</h1>
      <p class="lede">I'm Sam. I work on IT systems, build hardware, and write about what I learn along the way.</p>
      <div class="cta-row"><a class="button primary" href="/work/">Explore my projects</a><a class="text-link" href="/writing/">Read my notes</a></div>
    </div>
    <div class="featured-build">
      <p class="eyebrow">Featured build</p>
      <a class="feature-image" href="/work/tempest-dux/" aria-label="Explore the Tempest Dux prototype"><img src="/photos/tempest-dux-yellow-trackball-detail.jpg" alt="Tempest Dux prototype with black keys, a yellow trackball in a printed mount, and exposed display wiring." width="1280" height="960" fetchpriority="high" /></a>
      <h2><a href="/work/tempest-dux/">Tempest Dux</a></h2>
      <p>A split keyboard with a trackball on each half. A modified PCB, printed parts, and plenty of revisions.</p>
      <a class="text-link" href="/writing/building-the-tempest-dux/">Read the build story</a>
    </div>
  </section>
  <section class="home-section writing-section" aria-labelledby="writing-title">
    <div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2 id="writing-title">Recent writing</h2></div><a href="/writing/">All writing</a></div>
    <ul class="editorial-list">{posts.map(post=><li><div class="post-date"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></div><div><h3><a href={'/writing/'+post.id+'/'}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={'/writing/'+post.id+'/'}>Read article</a></div></li>)}</ul>
  </section>
  <section class="home-section" aria-labelledby="project-title"><div class="section-heading"><div><p class="eyebrow">More things I've worked on</p><h2 id="project-title">Selected projects</h2></div><a href="/work/">All projects</a></div>
    <ul class="project-pair">{selected.map(item=>item&&<li><h3><a href={'/work/'+item.id+'/'}>{item.data.title}</a></h3><p>{item.data.summary}</p><a class="text-link" href={'/work/'+item.id+'/'}>Explore the project</a></li>)}</ul>
  </section>
  <section class="about-note home-section"><p class="eyebrow">A little about me</p><h2>At the desk. At the workbench.</h2><p>My work moves between IT operations and hands-on engineering. I like understanding how a system behaves, making it easier to support, and documenting the decisions behind it.</p><div class="cta-row"><a class="text-link" href="/about/">More about me</a><a href="https://zerobeatlabs.org/">Work with me through ZeroBeatLabs</a></div></section>
</Base>
