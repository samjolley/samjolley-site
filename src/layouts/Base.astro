---
import '../styles/global.css';
import ThemeSetup from '../components/ThemeSetup.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  structuredData?: object;
  noindex?: boolean;
}

const { title, description, ogType = 'website', structuredData, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sam Jolley',
  url: 'https://samjolley.com',
  jobTitle: 'IT operations and automation engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'ZeroBeatLabs',
    url: 'https://zerobeatlabs.org',
  },
  // sameAs: list only live profiles. Add each as it is claimed.
  sameAs: ['https://github.com/samjolley', 'https://www.linkedin.com/in/samjolley'],
};

const current = Astro.url.pathname.replace(/\/?$/, '/');
const nav = navItems;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta id="samjolley-theme-color" name="theme-color" content="#f7f3eb" />
    <ThemeSetup />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sam Jolley Writing"
      href="/rss.xml"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sam Jolley" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
  </head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="site-name" href="/">Sam Jolley</a>
    <nav class="site-nav" aria-label="Main navigation"><ul>
    {nav.map(item=><li><a href={item.href} aria-current={(item.href==='/'?current==='/':current.startsWith(item.href))?'page':undefined}>{item.label}</a></li>)}
    </ul></nav>
    <ThemeToggle />
  </header>
  <main id="main" class="wrap" tabindex="-1"><slot /></main>
  <footer class="site-footer wrap">
    <div><a class="footer-name" href="/">Sam Jolley</a><p>Projects, systems, and useful lessons.</p></div>
    <div class="footer-links"><a href="/writing/">Writing</a><a href="/links/">Find me elsewhere</a><a href="https://zerobeatlabs.org/">ZeroBeatLabs</a><a href="/privacy/">Privacy</a></div>
    <p class="fine-print">© {new Date().getFullYear()} Sam Jolley</p>
  </footer>
</body>
</html>
